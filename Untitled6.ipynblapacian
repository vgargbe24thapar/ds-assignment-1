        "# QUESTION 2: Sharpening using Sobel and Canny\n",
        "\n",
        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "img = cv2.imread('assignment 7.jpg', cv2.IMREAD_GRAYSCALE)\n",
        "\n",
        "# --- USER-DEFINED IMPLEMENTATION (SOBEL) ---\n",
        "def user_defined_sobel_sharpen(img):\n",
        "    sobel_x = np.array([\n",
        "        [-1, 0, 1],\n",
        "        [-2, 0, 2],\n",
        "        [-1, 0, 1]\n",
        "    ], dtype=np.float32)\n",
        "\n",
        "    sobel_y = np.array([\n",
        "        [-1, -2, -1],\n",
        "        [0, 0, 0],\n",
        "        [1, 2, 1]\n",
        "    ], dtype=np.float32)\n",
        "\n",
        "    grad_x = custom_convolve2d(\n",
        "        img.astype(np.float32),\n",
        "        sobel_x\n",
        "    )\n",
        "\n",
        "    grad_y = custom_convolve2d(\n",
        "        img.astype(np.float32),\n",
        "        sobel_y\n",
        "    )\n",
        "\n",
        "    magnitude = np.sqrt(grad_x**2 + grad_y**2)\n",
        "\n",
        "    sharpened = img.astype(np.float32) + (magnitude * 0.5)\n",
        "\n",
        "    return np.clip(sharpened, 0, 255).astype(np.uint8)\n",
        "\n",
        "\n",
        "# --- INBUILT IMPLEMENTATION (SOBEL & CANNY) ---\n",
        "def inbuilt_sobel_canny_sharpen(img):\n",
        "\n",
        "    # Inbuilt Sobel\n",
        "    grad_x = cv2.Sobel(\n",
        "        img,\n",
        "        cv2.CV_32F,\n",
        "        1, 0,\n",
        "        ksize=3\n",
        "    )\n",
        "\n",
        "    grad_y = cv2.Sobel(\n",
        "        img,\n",
        "        cv2.CV_32F,\n",
        "        0, 1,\n",
        "        ksize=3\n",
        "    )\n",
        "\n",
        "    magnitude = cv2.magnitude(grad_x, grad_y)\n",
        "\n",
        "    sobel_sharp = np.clip(\n",
        "        img.astype(np.float32) + (magnitude * 0.5),\n",
        "        0,\n",
        "        255\n",
        "    ).astype(np.uint8)\n",
        "\n",
        "    # Inbuilt Canny\n",
        "    canny_edges = cv2.Canny(img, 100, 200)\n",
        "\n",
        "    canny_sharp = np.clip(\n",
        "        img.astype(np.float32) +\n",
        "        (canny_edges.astype(np.float32) * 0.5),\n",
        "        0,\n",
        "        255\n",
        "    ).astype(np.uint8)\n",
        "\n",
        "    return sobel_sharp, canny_sharp\n",
        "\n",
        "\n",
        "# --- EXECUTION & VISUALIZATION ---\n",
        "\n",
        "# Assumes 'img' and 'custom_convolve2d' are already\n",
        "# loaded/defined in the namespace from Cell 1\n",
        "\n",
        "user_sobel = user_defined_sobel_sharpen(img)\n",
        "\n",
        "inbuilt_sobel, inbuilt_canny = inbuilt_sobel_canny_sharpen(img)\n",
        "\n",
        "\n",
        "# Display results\n",
        "fig, axes = plt.subplots(1, 4, figsize=(20, 5))\n",
        "\n",
        "axes[0].imshow(img, cmap='gray')\n",
        "axes[0].set_title(\"Original\")\n",
        "\n",
        "axes[1].imshow(user_sobel, cmap='gray')\n",
        "axes[1].set_title(\"User-Defined Sobel\")\n",
        "\n",
        "axes[2].imshow(inbuilt_sobel, cmap='gray')\n",
        "axes[2].set_title(\"Inbuilt Sobel\")\n",
        "\n",
        "axes[3].imshow(inbuilt_canny, cmap='gray')\n",
        "axes[3].set_title(\"Inbuilt Canny\")\n",
        "\n",
        "for ax in axes:\n",
        "    ax.axis('off')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
