        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --------------------------------------------------\n",
        "# LOAD IMAGE\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Upload your image in Google Colab and enter its name here\n",
        "\n",
        "\n",
        "img = cv2.imread('assignment 7.jpg', cv2.IMREAD_GRAYSCALE)\n",
        "\n",
        "if img is None:\n",
        "    raise FileNotFoundError(\"Image not found. Check the image filename.\")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# CUSTOM 2D CONVOLUTION\n",
        "# --------------------------------------------------\n",
        "\n",
        "def custom_convolve2d(img, kernel):\n",
        "    kh, kw = kernel.shape\n",
        "    pad_h = kh // 2\n",
        "    pad_w = kw // 2\n",
        "\n",
        "    padded = np.pad(\n",
        "        image,\n",
        "        ((pad_h, pad_h), (pad_w, pad_w)),\n",
        "        mode='reflect'\n",
        "    )\n",
        "\n",
        "    output = np.zeros_like(image, dtype=np.float32)\n",
        "\n",
        "    for i in range(image.shape[0]):\n",
        "        for j in range(image.shape[1]):\n",
        "            region = padded[i:i + kh, j:j + kw]\n",
        "            output[i, j] = np.sum(region * kernel)\n",
        "\n",
        "    return output\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# USER-DEFINED GAUSSIAN KERNEL\n",
        "# --------------------------------------------------\n",
        "\n",
        "def generate_gaussian_kernel(size, sigma):\n",
        "    kernel = np.zeros((size, size), dtype=np.float32)\n",
        "\n",
        "    center = size // 2\n",
        "\n",
        "    for x in range(size):\n",
        "        for y in range(size):\n",
        "            diff_x = x - center\n",
        "            diff_y = y - center\n",
        "\n",
        "            kernel[x, y] = np.exp(\n",
        "                -(diff_x**2 + diff_y**2) / (2 * sigma**2)\n",
        "            )\n",
        "\n",
        "    return kernel / np.sum(kernel)\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# USER-DEFINED UNSHARP MASKING\n",
        "# --------------------------------------------------\n",
        "\n",
        "def user_defined_unsharp_mask(img):\n",
        "    gauss_kernel = generate_gaussian_kernel(5, 3.0)\n",
        "\n",
        "    blurred = custom_convolve2d(\n",
        "        img.astype(np.float32),\n",
        "        gauss_kernel\n",
        "    )\n",
        "\n",
        "    mask = (\n",
        "        img.astype(np.float32)\n",
        "        - blurred.astype(np.float32)\n",
        "    )\n",
        "\n",
        "    sharpened = (\n",
        "        img.astype(np.float32)\n",
        "        + 1.5 * mask\n",
        "    )\n",
        "\n",
        "    return np.clip(\n",
        "        sharpened, 0, 255\n",
        "    ).astype(np.uint8)\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# INBUILT UNSHARP MASKING\n",
        "# --------------------------------------------------\n",
        "\n",
        "def inbuilt_unsharp_mask(img):\n",
        "\n",
        "    # Gaussian filter of size 5x5 and sigma = 3\n",
        "    blurred = cv2.GaussianBlur(\n",
        "        img,\n",
        "        (5, 5),\n",
        "        3.0\n",
        "    )\n",
        "\n",
        "    mask = (\n",
        "        img.astype(np.float32)\n",
        "        - blurred.astype(np.float32)\n",
        "    )\n",
        "\n",
        "    sharpened = (\n",
        "        img.astype(np.float32)\n",
        "        + 1.5 * mask\n",
        "    )\n",
        "\n",
        "    return np.clip(\n",
        "        sharpened, 0, 255\n",
        "    ).astype(np.uint8)\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# EXECUTION\n",
        "# --------------------------------------------------\n",
        "\n",
        "user_unsharp = user_defined_unsharp_mask(img)\n",
        "\n",
        "inbuilt_unsharp = inbuilt_unsharp_mask(img)\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# VISUALIZATION\n",
        "# --------------------------------------------------\n",
        "\n",
        "fig, axes = plt.subplots(\n",
        "    1, 3,\n",
        "    figsize=(15, 5)\n",
        ")\n",
        "\n",
        "axes[0].imshow(img, cmap='gray')\n",
        "axes[0].set_title(\"Original\")\n",
        "\n",
        "axes[1].imshow(user_unsharp, cmap='gray')\n",
        "axes[1].set_title(\"User-Defined Unsharp Mask\")\n",
        "\n",
        "axes[2].imshow(inbuilt_unsharp, cmap='gray')\n",
        "axes[2].set_title(\"Inbuilt Unsharp Mask\")\n",
        "\n",
        "for ax in axes:\n",
        "    ax.axis(\"off\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
