        "# ============================================================\n",
        "# QUESTION 1: Sharpening using Laplacian Filter\n",
        "# ============================================================\n",
        "\n",
        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Load image in grayscale\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "image = cv2.imread('assignment 7.jpg', cv2.IMREAD_GRAYSCALE)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# USER-DEFINED IMPLEMENTATION\n",
        "# A from-scratch implementation of 2D convolution\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def custom_convolve2d(image, kernel):\n",
        "    \"\"\"A from-scratch implementation of 2D convolution.\"\"\"\n",
        "\n",
        "    kernel = np.flipud(np.fliplr(kernel))\n",
        "\n",
        "    pad_h, pad_w = kernel.shape[0] // 2, kernel.shape[1] // 2\n",
        "\n",
        "    padded = np.pad(\n",
        "        image,\n",
        "        ((pad_h, pad_h), (pad_w, pad_w)),\n",
        "        mode='reflect'\n",
        "    )\n",
        "\n",
        "    output = np.zeros_like(image, dtype=np.float32)\n",
        "\n",
        "    for i in range(image.shape[0]):\n",
        "        for j in range(image.shape[1]):\n",
        "\n",
        "            region = padded[\n",
        "                i:i + kernel.shape[0],\n",
        "                j:j + kernel.shape[1]\n",
        "            ]\n",
        "\n",
        "            output[i, j] = np.sum(region * kernel)\n",
        "\n",
        "    return output\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# USER-DEFINED LAPLACIAN IMPLEMENTATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def user_defined_laplacian(img):\n",
        "\n",
        "    lap_kernel = np.array(\n",
        "        [\n",
        "            [0, 1, 0],\n",
        "            [1, -4, 1],\n",
        "            [0, 1, 0]\n",
        "        ],\n",
        "        dtype=np.float32\n",
        "    )\n",
        "\n",
        "    laplacian_edges = custom_convolve2d(\n",
        "        img.astype(np.float32),\n",
        "        lap_kernel\n",
        "    )\n",
        "\n",
        "    sharpened = (\n",
        "        img.astype(np.float32) - laplacian_edges\n",
        "    )\n",
        "\n",
        "    return np.clip(\n",
        "        sharpened,\n",
        "        0,\n",
        "        255\n",
        "    ).astype(np.uint8)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# INBUILT IMPLEMENTATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def inbuilt_laplacian(img):\n",
        "\n",
        "    laplacian_edges = cv2.Laplacian(\n",
        "        img,\n",
        "        cv2.CV_32F\n",
        "    )\n",
        "\n",
        "    sharpened = (\n",
        "        img.astype(np.float32) - laplacian_edges\n",
        "    )\n",
        "\n",
        "    return np.clip(\n",
        "        sharpened,\n",
        "        0,\n",
        "        255\n",
        "    ).astype(np.uint8)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# EXECUTION & VISUALIZATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Check if image was loaded successfully\n",
        "if image is None:\n",
        "    print(\"Error: Image could not be loaded.\")\n",
        "else:\n",
        "\n",
        "    # Apply user-defined Laplacian\n",
        "    custom_result = user_defined_laplacian(image)\n",
        "\n",
        "    # Apply OpenCV built-in Laplacian\n",
        "    builtin_result = inbuilt_laplacian(image)\n",
        "\n",
        "    # Display results\n",
        "    plt.figure(figsize=(15, 5))\n",
        "\n",
        "    plt.subplot(1, 3, 1)\n",
        "    plt.imshow(image, cmap='gray')\n",
        "    plt.title('Original Image')\n",
        "    plt.axis('off')\n",
        "\n",
        "    plt.subplot(1, 3, 2)\n",
        "    plt.imshow(custom_result, cmap='gray')\n",
        "    plt.title('User-Defined Laplacian')\n",
        "    plt.axis('off')\n",
        "\n",
        "    plt.subplot(1, 3, 3)\n",
        "    plt.imshow(builtin_result, cmap='gray')\n",
        "    plt.title('OpenCV Laplacian')\n",
        "    plt.axis('off')\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
